{
    "name": "gizmocraft/zendframework1-view",
    "description": "Zend Framework 1 View component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-currency"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-exception"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-loader"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-config"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-xml"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-server"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-cache"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-log"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-locale"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-registry"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-filter"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-crypt"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-date"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-http"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-session"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-uri"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-validate"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-translate"
        }
    ],
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-currency": "^2.0.0",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-filter": "^2.0.0",
        "gizmocraft/zendframework1-http": "^2.0.0",
        "gizmocraft/zendframework1-json": "^2.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-locale": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-translate": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_View_": "src/"
        },
        "classmap": [
            "src/Zend/View.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "include-path": [
        "src/"
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6.19 || ^10.5.18",
        "phpstan/phpstan": "2.1.33",
        "friendsofphp/php-cs-fixer": "3.92.5",
        "maglnet/composer-require-checker": "^3.0.0",
        "phpro/grumphp-shim": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=756M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "gizmocraft/zendframework1-view-helper-paginationcontrol": "For the PaginationControl View Helper",
        "gizmocraft/zendframework1-view-helper-navigation": "For the Navigation View Helper",
        "gizmocraft/zendframework1-view-helper-layout": "For the Layout View Helper",
        "gizmocraft/zendframework1-view-helper-action": "For the Action View Helper",
        "gizmocraft/zendframework1-view-helper-partial": "For the Partial and PartialLoop View Helpers",
        "gizmocraft/zendframework1-view-helper-url": "For the Url View Helper",
        "gizmocraft/zendframework1-view-helper-baseurl": "For the BaseUrl View Helper",
        "ext-filter": "Used in the HeadScript View Helper"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
